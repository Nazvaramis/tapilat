<Window x:Class="UAC_proiect.ModifyJobOfferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UAC_proiect"
        mc:Ignorable="d"
        Title="ModifyJobOfferWindow" Height="450" Width="800">
    <Grid RenderTransformOrigin="0.372,0.332">

        <TextBox x:Name="Title" Text="Title" RenderTransformOrigin="1.642,1.702" Margin="33,10,654,0" FontSize="18" FontWeight="Bold" VerticalAlignment="Top" Height="40"/>
        <TextBox x:Name="Description" Text="Descrption" RenderTransformOrigin="1.642,1.702" Grid.Row="0"  Margin="33,95,654,0" FontSize="18" FontWeight="Bold" VerticalAlignment="Top"/>
        <TextBox x:Name="TitleTextBox" RenderTransformOrigin="0.085,1.705" Margin="35,47,221,343">
            <TextBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.384"/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBox.RenderTransform>
        </TextBox>
        <TextBox x:Name="DescriptionBox" Margin="33,126,219,10" RenderTransformOrigin="0.509,0.474" Text=""/>
        <Button x:Name="SubmitChanges" Margin="590,11,10,372" Content="Submit changes" RenderTransformOrigin="0.05,0.969" FontSize="18" FontWeight="Bold" Click="SubmitChanges_Click">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.231"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <Button x:Name="Exit" Margin="586,74,10,313" Content="Exit" RenderTransformOrigin="0.05,0.969" FontSize="18" FontWeight="Bold" Click="Exit_Click"/>
        <Button x:Name="DeletePost" Margin="586,141,10,244" Content="Delete Post" Click="DeletePost_Click" RenderTransformOrigin="0,1.667" FontSize="18" FontWeight="Bold"/>


    </Grid>
</Window>
