<Window x:Class="UAC_proiect.ApplyJobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UAC_proiect"
        mc:Ignorable="d"
        Title="ApplyJobWindow" Height="450" Width="800">

    <Grid>
        <TextBlock Text="Years of Experience" Margin="33,10,0,0" FontSize="18" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Left"/>

        <TextBox x:Name="YearsOfExperienceTextBox"
                 Margin="35,47,500,0"
                 Height="30"
                 VerticalAlignment="Top"/>

        <TextBlock Text="CV Description" Margin="33,95,0,0" FontSize="18" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Left"/>

        <TextBox x:Name="CvDescriptionTextBox"
                 Margin="33,126,219,80"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>

        <Button x:Name="ApplyButton"
                Margin="586,11,10,372"
                Content="Apply"
                FontSize="18"
                FontWeight="Bold"
                Click="ApplyButton_Click"/>

        <Button x:Name="ExitButton"
                Margin="586,74,10,313"
                Content="Exit"
                FontSize="18"
                FontWeight="Bold"
                Click="ExitButton_Click"/>
    </Grid>
</Window>